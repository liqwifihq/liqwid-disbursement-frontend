BACKEND_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3001
INTERNAL_API_TOKEN=replace-with-the-same-token-used-by-the-backend
ADMIN_EMAIL=admin@example.com
# For local development only. Prefer ADMIN_PASSWORD_HASH outside development.
ADMIN_PASSWORD=replace-this-password
AUTH_SECRET=replace-with-at-least-32-random-characters
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional multi-user production configuration. Each user requires a scrypt hash and role.
# ADMIN_USERS_JSON=[{"email":"maker@example.com","role":"maker","passwordHash":"scrypt$salt$hash"},{"email":"approver@example.com","role":"approver","passwordHash":"scrypt$salt$hash"}]
